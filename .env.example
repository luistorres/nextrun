# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextrun
REDIS_URL=redis://localhost:6379
AUTH_SECRET=          # openssl rand -base64 32
AUTH_URL=http://localhost:3000
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=       # openssl rand -hex 32, encrypts stored Garmin tokens
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: where downloaded FIT files are stored (default ./storage/fit)
FIT_STORAGE_DIR=./storage/fit

# Optional: Telegram notifications for waitlist signups, with approve-from-Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional: dormant official Garmin OAuth path; sign-in does not use it
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
